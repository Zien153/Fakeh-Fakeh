# Environment variables (NEVER commit secrets)

# AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Gateway (ShamCash)
SHAMCASH_MERCHANT_ID=your_shamcash_merchant_id
SHAMCASH_SECRET_KEY=your_shamcash_secret_key

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (comma-separated for production)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_AI=10

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/fakeh_fakeh

# Redis Configuration (for distributed caching & session storage)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Session Configuration
SESSION_SECRET=your_super_secret_session_key_change_in_production
